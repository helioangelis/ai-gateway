# Preencha só o bloco "OBRIGATÓRIO". Este arquivo NUNCA vai para o GitHub (.gitignore);
# o setup envia cada linha preenchida como segredo do repositório.

# ====== OBRIGATÓRIO PARA PUBLICAR ======
# Cloudflare: painel > Meu perfil > Tokens de API > modelo "Edit Cloudflare Workers"
# e acrescente a permissão "Workers KV Storage: Edit" (é onde ficam as IAs conectadas).
CLOUDFLARE_API_TOKEN=
# Cloudflare: ID da conta (aparece na página inicial do painel, lado direito)
CLOUDFLARE_ACCOUNT_ID=

# Senha que protege o seu gateway. Deixe vazio e o setup cria uma sozinho.
GATEWAY_TOKEN=

# ====== AS IAs ======
# Você NÃO precisa preencher nada aqui: no app, Ajustes > Conectar em cada IA
# (OpenRouter tem login direto; as outras abrem a página de login/chave e você cola).
# Se preferir, pode colocar as chaves aqui; elas valem como "chave do servidor".
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENCODE_API_KEY=
CLOUDFLARE_API_KEY=

# ====== SÓ PARA RODAR LOCAL NO TERMUX (opcional) ======
PORT=8787
HOST=127.0.0.1
