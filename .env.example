# Copie para .env (opcional). Tudo aqui pode ser feito pelo painel.

# Segredo que cifra as chaves em repouso. Se ficar vazio, é gerado em data/.secret.
ENCRYPTION_KEY=

# Chave que protege o gateway. Se ficar vazia, é gerada em data/.token.
GATEWAY_TOKEN=

PORT=8787
HOST=127.0.0.1

# Chaves dos provedores (opcional — o painel cadastra e valida na hora).
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENCODE_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
